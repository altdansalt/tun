load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Read by //internal/client tests that run them in jobs.
exports_files([
    "bazel-ci.sh",
    "ci.sh",
    "bb-ci.sh",
])

# The real-CLI smoke suites (what scripts/ci.sh runs at the end via dev-tun.sh), against the
# Bazel-built binary. Each starts a private `tun serve --ephemeral` with bwrap sandboxes and
# network namespaces, nested in Bazel's sandbox; all traffic is loopback.
[sh_test(
    name = name,
    size = "medium",
    srcs = ["bazel-e2e.sh"],
    args = [
        "$(rootpath //cmd/tun)",
        "$(rootpath @go_sdk//:bin/go)",
        "$(rootpath %s)" % suite,
        # e2e.sh's tun bazel smoke step runs Bazel nested in this test: no bazelisk download.
        "$(rootpath @bazel_binary//file)",
    ],
    data = [
        "dev-tun.sh",
        "e2e-drain.py",
        suite,
        "//cmd/tun",
        "@bazel_binary//file",
        "@go_sdk//:bin/go",
        "@go_sdk//:files",
    ],
    env = env,
    # e2e.sh's tun bazel step: nested real Bazel fetches modules from the Bazel Central Registry.
    tags = ["requires-network"],
) for name, suite, env in [
    ("e2e_test", "e2e.sh", {}),
    (
        "e2e_runners_test",
        "e2e-runners.sh",
        {"DEV_TUN_SERVE_ARGS": "--local-slots 0 --runner-timeout 3s"},
    ),
]]
