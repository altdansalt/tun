load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "reapi",
    srcs = [
        "action.go",
        "grpc.go",
        "store.go",
        "wire.go",
    ],
    importpath = "github.com/altdansalt/tun/internal/reapi",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "reapi_test",
    srcs = [
        "reapi_test.go",
        "review_test.go",
    ],
    # Real Bazel nested in this test (TestBazelCache): the pinned binary, not bazelisk.
    data = ["@bazel_binary//file"],
    embed = [":reapi"],
    env = {"TUN_TEST_BAZEL": "$(rlocationpath @bazel_binary//file)"},
    # Nested real Bazel fetches modules from the Bazel Central Registry (via the proxy, .bazelrc).
    tags = ["requires-network"],
)
